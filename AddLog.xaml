<Window x:Class="Fuel_Loger.AddLog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Fuel_Loger"
        mc:Ignorable="d"
        Title="AddLog" Height="300" Width="300">
    <Grid>
        <GroupBox Height="250" Header="GroupBox" Width="200">
            <StackPanel>
                <DatePicker Name="dtSelectDate"  Margin="0,20,0,0"></DatePicker>
                <TextBox Name="txbAmount" Margin="0,30,0,0" Text="Amount in Litres"></TextBox>
                <TextBox Name="txbCost" Margin="0,30,0,0" Text="Cost"></TextBox>
                <Button Margin="0,30,0,0" Click="Button_Click">Add</Button>
            </StackPanel>
        </GroupBox>
    </Grid>
</Window>
